{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": ["Renovate config for Node.js/TypeScript projects"],
  "extends": ["github>h13/renovate-config"],
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": [
        "!/^eslint/",
        "!/^@eslint\\//",
        "!/^typescript-eslint/",
        "!/^prettier/",
        "!/^@biomejs\\//",
        "!/^oxlint/",
        "!/^@oxlint\\//",
        "!/^oxfmt/",
        "!/^@oxfmt\\//",
        "!/^oxlint-tsgolint/",
        "!/^jest/",
        "!/^@jest\\//",
        "!/^vitest/",
        "!/^@vitest\\//",
        "!/^@testing-library\\//",
        "!/^mocha/",
        "!/^chai/",
        "!/^sinon/",
        "!c8",
        "!nyc",
        "!/^@types\\//",
        "!/^stylelint/",
        "!/^postcss/",
        "!/^webpack/",
        "!/^vite/",
        "!/^@vitejs\\//",
        "!/^esbuild/",
        "!/^rollup/",
        "!/^@rollup\\//",
        "!tsup",
        "!turbopack"
      ],
      "groupName": "dev dependencies"
    },
    {
      "matchPackageNames": [
        "/^eslint/",
        "/^@eslint\\//",
        "/^typescript-eslint/",
        "/^eslint-config-/",
        "/^eslint-plugin-/"
      ],
      "groupName": "eslint",
      "enabled": false
    },
    {
      "matchPackageNames": ["/^prettier/", "/^@biomejs\\//"],
      "groupName": "formatter",
      "enabled": false
    },
    {
      "matchPackageNames": [
        "/^oxlint/",
        "/^@oxlint\\//",
        "/^oxfmt/",
        "/^@oxfmt\\//",
        "oxlint-tsgolint"
      ],
      "groupName": "oxc toolchain",
      "automerge": true
    },
    {
      "matchPackageNames": ["/^stylelint/", "/^postcss/"],
      "groupName": "stylelint"
    },
    {
      "matchPackageNames": [
        "/^jest/",
        "/^@jest\\//",
        "/^vitest/",
        "/^@vitest\\//",
        "/^@testing-library\\//",
        "/^mocha/",
        "/^chai/",
        "/^sinon/",
        "c8",
        "nyc"
      ],
      "groupName": "testing"
    },
    {
      "matchPackageNames": ["/^@types\\//"],
      "groupName": "type definitions"
    },
    {
      "matchPackageNames": [
        "/^webpack/",
        "/^vite/",
        "/^@vitejs\\//",
        "/^esbuild/",
        "/^rollup/",
        "/^@rollup\\//",
        "tsup",
        "turbopack"
      ],
      "groupName": "bundler"
    }
  ]
}
