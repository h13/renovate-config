{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": ["Renovate config for Node.js/TypeScript projects"],
  "extends": ["github>h13/renovate-config"],
  "packageRules": [
    {
      "description": [
        "Catch-all for devDependencies; must stay first so the specific groups below override it (packageRules apply last-match-wins)"
      ],
      "matchDepTypes": ["devDependencies"],
      "groupName": "dev dependencies"
    },
    {
      "matchPackageNames": [
        "/^oxlint/",
        "/^@oxlint\\//",
        "/^oxfmt/",
        "/^@oxfmt\\//",
        "oxlint-tsgolint"
      ],
      "groupName": "oxc toolchain"
    },
    {
      "matchPackageNames": ["/^stylelint/", "/^postcss/"],
      "groupName": "stylelint"
    },
    {
      "matchPackageNames": [
        "/^jest/",
        "/^@jest\\//",
        "/^vitest/",
        "/^@vitest\\//",
        "/^@testing-library\\//",
        "/^mocha/",
        "/^chai/",
        "/^sinon/",
        "c8",
        "nyc"
      ],
      "groupName": "testing"
    },
    {
      "matchPackageNames": ["/^@types\\//"],
      "groupName": "type definitions"
    },
    {
      "matchPackageNames": [
        "/^webpack/",
        "vite",
        "/^vite-/",
        "/^@vitejs\\//",
        "/^esbuild/",
        "/^rollup/",
        "/^@rollup\\//",
        "tsup",
        "turbopack"
      ],
      "groupName": "bundler"
    },
    {
      "matchDepNames": ["pnpm"],
      "matchManagers": ["npm"],
      "groupName": "pnpm"
    },
    {
      "matchPackageNames": ["/^@swc\\//", "swc-loader"],
      "groupName": "swc"
    }
  ]
}
