{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": ["Renovate config for Node.js/TypeScript projects"],
  "extends": ["github>h13/renovate-config"],
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": [
        "!/^oxlint/",
        "!/^@oxlint\\//",
        "!/^oxfmt/",
        "!/^@oxfmt\\//",
        "!/^oxlint-tsgolint/",
        "!/^jest/",
        "!/^@jest\\//",
        "!/^vitest/",
        "!/^@vitest\\//",
        "!/^@testing-library\\//",
        "!/^mocha/",
        "!/^chai/",
        "!/^sinon/",
        "!c8",
        "!nyc",
        "!/^@types\\//",
        "!/^stylelint/",
        "!/^postcss/",
        "!/^webpack/",
        "!vite",
        "!/^vite-/",
        "!/^@vitejs\\//",
        "!/^esbuild/",
        "!/^rollup/",
        "!/^@rollup\\//",
        "!tsup",
        "!turbopack"
      ],
      "groupName": "dev dependencies"
    },
    {
      "matchPackageNames": [
        "/^oxlint/",
        "/^@oxlint\\//",
        "/^oxfmt/",
        "/^@oxfmt\\//",
        "oxlint-tsgolint"
      ],
      "groupName": "oxc toolchain",
      "automerge": true
    },
    {
      "matchPackageNames": ["/^stylelint/", "/^postcss/"],
      "groupName": "stylelint"
    },
    {
      "matchPackageNames": [
        "/^jest/",
        "/^@jest\\//",
        "/^vitest/",
        "/^@vitest\\//",
        "/^@testing-library\\//",
        "/^mocha/",
        "/^chai/",
        "/^sinon/",
        "c8",
        "nyc"
      ],
      "groupName": "testing"
    },
    {
      "matchPackageNames": ["/^@types\\//"],
      "groupName": "type definitions"
    },
    {
      "matchPackageNames": [
        "/^webpack/",
        "vite",
        "/^vite-/",
        "/^@vitejs\\//",
        "/^esbuild/",
        "/^rollup/",
        "/^@rollup\\//",
        "tsup",
        "turbopack"
      ],
      "groupName": "bundler"
    },
    {
      "matchDepNames": ["pnpm"],
      "matchManagers": ["npm"],
      "groupName": "pnpm"
    },
    {
      "matchPackageNames": ["/^@swc\\//", "swc-loader"],
      "groupName": "swc",
      "automerge": true
    }
  ]
}
