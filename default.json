{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": ["Base Renovate config for h13 repositories"],
  "extends": ["config:best-practices"],
  "minimumReleaseAge": "7 days",
  "timezone": "Asia/Tokyo",
  "schedule": ["after 9pm and before 11:59pm on sunday", "before 6am on monday"],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 4,
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "description": [
        "Update values annotated with `# renovate: datasource=... depName=...` in workflow files (e.g. reusable workflow input defaults)"
      ],
      "managerFilePatterns": ["/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"],
      "depTypeTemplate": "devDependencies",
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z0-9-.]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?\\n\\s*[A-Za-z0-9_-]+: \"?(?<currentValue>[^\"\\s]+?)\"?\\n"
      ]
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "!/^v?0\\./",
      "automerge": true
    },
    {
      "description": [
        "0.x minors can be breaking per semver; automerge them only for dev-scoped deps, where a broken update fails CI instead of production"
      ],
      "matchUpdateTypes": ["minor"],
      "matchDepTypes": ["devDependencies", "require-dev"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["breaking"]
    }
  ],
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "schedule": ["at any time"]
  }
}
